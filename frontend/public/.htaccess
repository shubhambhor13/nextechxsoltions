# NextTechX Solutions - Production Apache / LiteSpeed Web Server Configuration
# Supports Vite + React SPA Routing alongside PHP Backend APIs

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Security: Block direct HTTP access to data folder & internal includes
  RewriteRule ^data/ - [F,L]
  RewriteRule ^includes/ - [F,L]

  # 2. API Endpoint Aliases for Frontend Compatibility
  RewriteRule ^api/careers/apply/?$ api/apply_career.php [L,QSA]
  RewriteRule ^api/careers/vacancies/?$ api/apply_career.php?action=vacancies [L,QSA]
  RewriteRule ^api/careers/applications/?$ api/apply_career.php?action=applications [L,QSA]
  RewriteRule ^api/quotation/?$ api/quote.php [L,QSA]
  RewriteRule ^api/training/register/?$ api/apply.php [L,QSA]
  RewriteRule ^api/training/courses/?$ api/apply.php?action=courses [L,QSA]
  RewriteRule ^api/ai/chat/?$ api/chat.php [L,QSA]
  RewriteRule ^api/chat/?$ api/chat.php [L,QSA]
  RewriteRule ^api/consultation/?$ api/consultation.php [L,QSA]
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]

  # 3. Do not rewrite if requested resource physically exists as a file or directory
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Support direct PHP scripts if accessed with .php extension
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [L]

  # 5. Route all other requests to index.html for React client-side routing (HTML5 History API)
  RewriteRule ^ index.html [L]
</IfModule>

# Security: Deny direct access to sensitive config, database, and environment files
<FilesMatch "\.(db|sqlite|sqlite3|env|ini|log|sh|bat)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Static Asset Caching for high performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
