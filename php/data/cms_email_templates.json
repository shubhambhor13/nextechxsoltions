[
  {
    "template_key": "applicant_confirmation",
    "template_name": "Candidate Application Auto-Confirmation",
    "subject": "Application Received: {{position}} — NEXTECHX SOLUTIONS",
    "body_html": "<div style=\"font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;\">\n    <div style=\"background:#0a0f1e;padding:28px 32px;border-bottom:3px solid #2563eb;\">\n        <h1 style=\"color:#ffffff;margin:0;font-size:22px;letter-spacing:-0.5px;\">NEXTECHX <span style=\"color:#60a5fa;\">SOLUTIONS</span></h1>\n        <p style=\"color:#94a3b8;margin:6px 0 0;font-size:13px;\">Official Technical Careers & Internship Desk</p>\n    </div>\n    <div style=\"padding:32px;\">\n        <h2 style=\"color:#0f172a;font-size:18px;margin-top:0;\">Dear {{applicant_name}},</h2>\n        <p style=\"color:#475569;font-size:14px;line-height:1.6;\">Thank you for your interest in joining <strong>NEXTECHX SOLUTIONS</strong>. We have successfully logged your submission for the <strong>{{position}}</strong> ({{applying_for}} Program).</p>\n        \n        <div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px 20px;margin:20px 0;\">\n            <p style=\"margin:0 0 8px;font-size:12px;color:#64748b;text-transform:uppercase;font-weight:700;\">Submission Reference Summary</p>\n            <p style=\"margin:4px 0;font-size:13px;color:#1e293b;\"><strong>Candidate:</strong> {{applicant_name}}</p>\n            <p style=\"margin:4px 0;font-size:13px;color:#1e293b;\"><strong>Role:</strong> {{position}}</p>\n            <p style=\"margin:4px 0;font-size:13px;color:#1e293b;\"><strong>Program:</strong> {{applying_for}}</p>\n            <p style=\"margin:4px 0;font-size:13px;color:#1e293b;\"><strong>Status:</strong> Under Technical Review</p>\n        </div>\n\n        <p style=\"color:#475569;font-size:14px;line-height:1.6;\">Our engineering mentors review every resume individually against our active sprint needs. If your qualifications match our upcoming cohorts, our talent desk will contact you via email and WhatsApp to coordinate your technical screening interview.</p>\n        \n        <p style=\"color:#475569;font-size:14px;line-height:1.6;\">We appreciate your enthusiasm and wish you the best in your application process!</p>\n        \n        <div style=\"margin-top:30px;padding-top:20px;border-top:1px solid #e2e8f0;font-size:13px;color:#64748b;\">\n            <p style=\"margin:0;font-weight:700;color:#0f172a;\">Technical Recruitment Desk</p>\n            <p style=\"margin:4px 0 0;\">NEXTECHX SOLUTIONS • Distributed Online IT & Cloud Operations</p>\n            <p style=\"margin:2px 0 0;\"><a href=\"mailto:hr@nextechxsolutions.com\" style=\"color:#2563eb;text-decoration:none;\">hr@nextechxsolutions.com</a> • <a href=\"https://nextechxsolutions.com\" style=\"color:#2563eb;text-decoration:none;\">nextechxsolutions.com</a></p>\n        </div>\n    </div>\n</div>",
    "signature": "Technical Recruitment Desk • NEXTECHX SOLUTIONS",
    "is_active": 1
  },
  {
    "template_key": "company_application_notification",
    "template_name": "Internal Alert: New Candidate Application",
    "subject": "🔔 New Application: {{applicant_name}} — {{position}}",
    "body_html": "<div style=\"font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;\">\n    <div style=\"background:#0a0f1e;padding:24px 32px;border-bottom:3px solid #10b981;\">\n        <h2 style=\"color:#ffffff;margin:0;font-size:18px;\">New Technical Application Received</h2>\n        <p style=\"color:#94a3b8;margin:4px 0 0;font-size:12px;\">Logged in Centralized Management Database</p>\n    </div>\n    <div style=\"padding:28px 32px;\">\n        <table style=\"width:100%;border-collapse:collapse;font-size:13px;color:#1e293b;\">\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;width:35%;\">Applicant Name:</td><td style=\"padding:8px 0;font-weight:700;\">{{applicant_name}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Target Role:</td><td style=\"padding:8px 0;font-weight:700;color:#2563eb;\">{{position}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Category:</td><td style=\"padding:8px 0;\">{{applying_for}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Email Address:</td><td style=\"padding:8px 0;\"><a href=\"mailto:{{email}}\">{{email}}</a></td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Phone / WhatsApp:</td><td style=\"padding:8px 0;\">{{phone}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Education:</td><td style=\"padding:8px 0;\">{{education}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Resume File:</td><td style=\"padding:8px 0;\">{{resume_filename}}</td></tr>\n        </table>\n        <div style=\"margin-top:16px;background:#f8fafc;padding:12px 16px;border-radius:8px;border:1px solid #e2e8f0;\">\n            <span style=\"font-size:11px;color:#64748b;text-transform:uppercase;font-weight:700;\">Statement / Notes:</span>\n            <p style=\"margin:6px 0 0;font-size:13px;color:#334155;line-height:1.5;\">{{message}}</p>\n        </div>\n        <p style=\"margin-top:20px;font-size:12px;color:#94a3b8;\">Review and change application status in the NEXTECHX Admin Dashboard.</p>\n    </div>\n</div>",
    "signature": "NEXTECHX Automated Notification Engine",
    "is_active": 1
  },
  {
    "template_key": "contact_notification",
    "template_name": "Internal Alert: New Contact Inquiry",
    "subject": "📩 New Contact Inquiry from {{name}} ({{company}})",
    "body_html": "<div style=\"font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;\">\n    <div style=\"background:#0a0f1e;padding:24px 32px;border-bottom:3px solid #3b82f6;\">\n        <h2 style=\"color:#ffffff;margin:0;font-size:18px;\">New Client Advisory Inquiry</h2>\n        <p style=\"color:#94a3b8;margin:4px 0 0;font-size:12px;\">Received through website contact form</p>\n    </div>\n    <div style=\"padding:28px 32px;\">\n        <table style=\"width:100%;border-collapse:collapse;font-size:13px;color:#1e293b;\">\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;width:35%;\">Client Name:</td><td style=\"padding:8px 0;font-weight:700;\">{{name}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Company / Org:</td><td style=\"padding:8px 0;\">{{company}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Email Address:</td><td style=\"padding:8px 0;\"><a href=\"mailto:{{email}}\">{{email}}</a></td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Phone / WhatsApp:</td><td style=\"padding:8px 0;\">{{phone}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Service Area:</td><td style=\"padding:8px 0;font-weight:700;color:#2563eb;\">{{service_interest}}</td></tr>\n        </table>\n        <div style=\"margin-top:16px;background:#f8fafc;padding:12px 16px;border-radius:8px;border:1px solid #e2e8f0;\">\n            <span style=\"font-size:11px;color:#64748b;text-transform:uppercase;font-weight:700;\">Client Message / Scope:</span>\n            <p style=\"margin:6px 0 0;font-size:13px;color:#334155;line-height:1.5;\">{{message}}</p>\n        </div>\n    </div>\n</div>",
    "signature": "NEXTECHX Solutions Desk",
    "is_active": 1
  },
  {
    "template_key": "quotation_notification",
    "template_name": "Internal Alert: Project Quotation Request",
    "subject": "💼 Quotation Request: {{company}} — {{service_category}}",
    "body_html": "<div style=\"font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;\">\n    <div style=\"background:#0a0f1e;padding:24px 32px;border-bottom:3px solid #8b5cf6;\">\n        <h2 style=\"color:#ffffff;margin:0;font-size:18px;\">New Commercial Quotation Request</h2>\n        <p style=\"color:#94a3b8;margin:4px 0 0;font-size:12px;\">Submitted via Get a Quote Modal</p>\n    </div>\n    <div style=\"padding:28px 32px;\">\n        <table style=\"width:100%;border-collapse:collapse;font-size:13px;color:#1e293b;\">\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;width:35%;\">Contact Name:</td><td style=\"padding:8px 0;font-weight:700;\">{{name}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Company:</td><td style=\"padding:8px 0;font-weight:700;\">{{company}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Email Address:</td><td style=\"padding:8px 0;\"><a href=\"mailto:{{email}}\">{{email}}</a></td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Phone:</td><td style=\"padding:8px 0;\">{{phone}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Service Needed:</td><td style=\"padding:8px 0;font-weight:700;color:#2563eb;\">{{service_category}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Target Budget:</td><td style=\"padding:8px 0;font-weight:700;color:#10b981;\">{{budget_range}}</td></tr>\n            <tr style=\"border-bottom:1px solid #f1f5f9;\"><td style=\"padding:8px 0;color:#64748b;\">Timeline:</td><td style=\"padding:8px 0;\">{{project_timeline}}</td></tr>\n        </table>\n        <div style=\"margin-top:16px;background:#f8fafc;padding:12px 16px;border-radius:8px;border:1px solid #e2e8f0;\">\n            <span style=\"font-size:11px;color:#64748b;text-transform:uppercase;font-weight:700;\">Detailed Specifications:</span>\n            <p style=\"margin:6px 0 0;font-size:13px;color:#334155;line-height:1.5;\">{{requirements}}</p>\n        </div>\n    </div>\n</div>",
    "signature": "NEXTECHX Commercial Solutions Desk",
    "is_active": 1
  }
]